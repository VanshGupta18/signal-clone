# Backend configuration. All optional for local development.
# Nothing loads this file automatically: pass it with `uvicorn ... --env-file .env`,
# or export the variables in your shell (`set -a; . ./.env; set +a`) before `python seed.py`.

# Path of the local SQLite file (default: backend/signal.db).
# DB_PATH=signal.db

# Production only: set BOTH to keep the local file synced with a Turso Cloud database.
# Leave unset locally to use a plain SQLite file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
